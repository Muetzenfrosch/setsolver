@inherits LayoutComponentBase
@implements IDisposable
@inject LanguageState Language

<CascadingValue Value="Language.Texts">
    <main class="page">
        @Body
    </main>
    <footer class="foot">@Language.Texts.Footer</footer>
</CascadingValue>

@code {
    protected override void OnInitialized() => Language.Changed += StateHasChanged;

    public void Dispose() => Language.Changed -= StateHasChanged;
}
