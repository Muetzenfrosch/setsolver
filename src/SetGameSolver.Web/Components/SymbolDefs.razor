@* Gemeinsame Streifenmuster für alle Karten-SVGs auf der Seite. *@
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
        @foreach (var (name, color) in Patterns)
        {
            <pattern id="stripes-@name" width="1.6" height="4" patternUnits="userSpaceOnUse">
                <rect width="0.6" height="4" fill="@color" />
            </pattern>
        }
    </defs>
</svg>

@code {
    private static readonly (string Name, string Color)[] Patterns =
    [
        ("red", CardText.CssColor(SetGameSolver.Core.Model.Color.Red)),
        ("green", CardText.CssColor(SetGameSolver.Core.Model.Color.Green)),
        ("purple", CardText.CssColor(SetGameSolver.Core.Model.Color.Purple)),
    ];
}
