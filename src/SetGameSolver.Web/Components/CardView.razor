@using SetGameSolver.Core.Model
@using SetGameSolver.Core.Synthetic
@* Zeichnet eine Set-Karte als SVG (Hochformat, quer gedreht mit Landscape). Streifenmuster kommen aus <SymbolDefs />. *@

<svg class="card-view @(Highlight ? "highlight" : "") @(Uncertain ? "uncertain" : "")"
     viewBox="@(Landscape ? "0 0 89 57" : "0 0 57 89")" role="img" aria-label="@T.Describe(Card)">
    <g transform="@(Landscape ? "translate(0 57) rotate(-90)" : null)">
    <rect x="0.75" y="0.75" width="55.5" height="87.5" rx="4" class="card-face" />
    @for (var i = 0; i < Count; i++)
    {
        var cy = CardShapes.SymbolCenterY(i, Count);
        <g transform="translate(28.5 @cy.ToString(System.Globalization.CultureInfo.InvariantCulture))">
            @switch (Card.Shape)
            {
                case Shape.Diamond:
                    <polygon points="@CardShapes.DiamondPoints" fill="@Fill" stroke="@Ink" stroke-width="@StrokeWidth" />
                    break;
                case Shape.Oval:
                    <rect x="-18.75" y="-8.75" width="37.5" height="17.5" rx="8.75" fill="@Fill" stroke="@Ink" stroke-width="@StrokeWidth" />
                    break;
                default:
                    <path d="@CardShapes.SquigglePath" fill="@Fill" stroke="@Ink" stroke-width="@StrokeWidth" />
                    break;
            }
        </g>
    }
    </g>
</svg>

@code {
    // Maße und Formen wie auf den echten Karten: siehe CardShapes (auch für die Beispielbilder genutzt).
    private const double StrokeWidth = CardShapes.StrokeWidth;

    [Parameter, EditorRequired] public Card Card { get; set; }
    [Parameter] public bool Highlight { get; set; }
    [Parameter] public bool Uncertain { get; set; }
    /// <summary>Karte quer zeigen, wie sie auf dem Foto liegt.</summary>
    [Parameter] public bool Landscape { get; set; }
    [CascadingParameter] public Texts T { get; set; } = Texts.English;

    private int Count => (int)Card.Number + 1;
    private string Ink => CardText.CssColor(Card.Color);
    private string Fill => Card.Shading switch
    {
        Shading.Solid => Ink,
        Shading.Striped => $"url(#stripes-{Card.Color.ToString().ToLowerInvariant()})",
        _ => "none",
    };
}
